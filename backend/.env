# Database
DATABASE_URL=postgresql://sme_user:sme_password@localhost:5433/sme_payments

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Backend
BACKEND_PORT=3001

# WebAuthn / Passkeys
WEBAUTHN_RP_NAME=Programmable SME Settlement
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3002

# Platform Config
PLATFORM_TRANSACTION_FEE_BPS=50
PLATFORM_EARLY_PAY_FEE_BPS=250

# Platform Signing Key (ECDSA P-256, PKCS8 DER, base64-encoded)
# Used to sign Trust Envelope evidence packs. See documentation/platform-signing-key.md
PLATFORM_SIGNING_KEY=MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgCaBka8SlRZQdW6nzQsk2S+BAsiIYphp8ycYSVxsvoYWhRANCAAQYlsfRZZ6jBQ4Eway2Lf41bHAc6M3uD0JEdOJARDWirJyFK2FDFIJlr6ndmVvuy0iC4iVcu16lXROiUo+uRqmT

# External Anchoring (Sigstore Rekor)
ANCHOR_PROVIDER=rekor
REKOR_URL=https://rekor.sigstore.dev/api/v1/log/entries
ANCHOR_INTERVAL_MINUTES=1
