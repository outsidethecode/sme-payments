# Database
POSTGRES_USER=sme_user
POSTGRES_PASSWORD=sme_password
POSTGRES_DB=sme_payments
DATABASE_URL=postgresql://sme_user:sme_password@localhost:5433/sme_payments

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Backend
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001

# WebAuthn / Passkeys
WEBAUTHN_RP_NAME=Programmable SME Settlement
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Platform Config
PLATFORM_TRANSACTION_FEE_BPS=50
PLATFORM_EARLY_PAY_FEE_BPS=250
